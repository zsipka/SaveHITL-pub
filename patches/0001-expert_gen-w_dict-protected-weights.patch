--- a/Code/synthetic_experts/expert_gen.py	2026-10-12 10:38:19
+++ b/Code/synthetic_experts/expert_gen.py	2026-10-12 10:38:19
@@ -246,7 +246,7 @@
                     size=group_cfg['n']
             )]*len(PROTECTED_COL)
         
-        coefs_gen['protected'] = [None]*group_cfg['n']
+        coefs_gen['protected'] = [[None]*group_cfg['n']]*len(PROTECTED_COL)
         group_cfg['w_stdev'] = None
         group_cfg['w_mean'] = None
     #Verifying integrity and lack of conflicts when using spike and slab
